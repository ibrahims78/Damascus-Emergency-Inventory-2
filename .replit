modules = ["python-base-3.13", "nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export DAMASCUS_DESKTOP=1 DAMASCUS_SCHEMA_PATH=$PWD/lib/db/desktop-schema.sql DAMASCUS_DATA_DIR=$PWD/.damascus-data NODE_ENV=development; pnpm --filter @workspace/api-server run build && PORT=8080 node --enable-source-maps artifacts/api-server/dist/index.mjs & api_pid=$!; trap 'kill $api_pid 2>/dev/null || true' EXIT INT TERM; PORT=5000 pnpm --filter @workspace/web run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 22333
externalPort = 3001
