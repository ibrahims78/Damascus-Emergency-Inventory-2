# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Release credentials and signing material
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*private*key*
release-secrets/
release-staging/

# Workspace-only attachments and agent-generated previews
attached_assets/
/.agents/outputs/

# local PGlite data directory (created at runtime)
.damascus-data/


# v4.0.0 release binaries stay local (checksums + notes are tracked)
releases/v4.0.0/windows/*.zip
releases/v4.0.0/android/*.apk
releases/v4.0.0/android/*WebBundle*.zip
