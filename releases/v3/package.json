{
  "name": "damascus-emergency-inventory-desktop",
  "version": "3.0.6",
  "description": "Desktop edition of the Damascus Emergency Inventory application.",
  "author": {
    "name": "Damascus Emergency Inventory",
    "email": "ibrahims78@users.noreply.github.com"
  },
  "homepage": "https://github.com/ibrahims78/Damascus-Emergency-Inventory",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibrahims78/Damascus-Emergency-Inventory.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "prepare-app": "pnpm --dir ../../artifacts/web run build && pnpm --dir ../../artifacts/api-server run build && node scripts/copy-app.cjs",
    "start": "electron .",
    "dev": "pnpm run prepare-app && electron .",
    "package:dir": "pnpm run prepare-app && electron-builder --dir",
    "package": "pnpm run prepare-app && electron-builder"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "syrian.emergency.inventory.desktop",
    "productName": "Damascus Emergency Inventory",
    "asar": true,
    "files": [
      "electron/**/*",
      "app/web/**/*",
      "app/api/**/*",
      "app/schema/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}